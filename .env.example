# AfterStory 环境配置。M1 已接入数据库、文本模型和本地用户配置。
# 语音、ASR、Embedding 和数据目录字段保留给后续阶段，当前不启用。
# 本地 .env 不提交 Git；仓库仅提交 .env.example。
# 密钥仅供后端读取，不添加 VITE_ 前缀。

# 本地服务（建议值）
APP_NAME=AfterStory
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
USER_TIMEZONE=Asia/Shanghai

# 相对路径约定：以仓库根目录解析
DATA_DIR=./data
DATABASE_URL=postgresql+psycopg://afterstory:afterstory_local@127.0.0.1:54329/afterstory
CHARACTERS_DIR=./characters
AUDIO_DIR=./data/audio

# 文本模型：首次采用 DeepSeek V4 Flash，后续可替换；密钥只填本地 .env
# Named model profiles: API endpoint, key and model belong to the same group.
LLM_ACTIVE_MODEL=deepseek
DEEPSEEK_PROVIDER=deepseek
DEEPSEEK_BASE_URL='https://api.deepseek.com'
DEEPSEEK_API_KEY=''
DEEPSEEK_MODEL='deepseek-v4-flash'
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=1024
# OTHER_CHAT_PROVIDER=openai_compatible
# OTHER_CHAT_BASE_URL=https://your-provider.example/v1
# OTHER_CHAT_API_KEY=
# OTHER_CHAT_MODEL=your-model-id
# OTHER_CHAT_TIMEOUT_SECONDS=60
# OTHER_CHAT_MAX_TOKENS=1024

DEV_USER_ID=local-user
TURN_LEASE_SECONDS=120
HISTORY_TURNS=12

# 语音合成：按选定供应商填写；各角色 voice_id 后续放角色配置
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_TIMEOUT_SECONDS=60

# 语音识别：暂不接入时留空
ASR_PROVIDER=
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT_SECONDS=60

# 向量模型：采用语义检索时再填写
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
