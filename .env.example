# AfterStory 环境配置草案。后续代码需要按这些变量名读取，当前尚未接入。
# 本地 .env 不提交 Git；仓库仅提交 .env.example。
# 密钥仅供后端读取，不添加 VITE_ 前缀。

# 本地服务（建议值）
APP_NAME=AfterStory
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
USER_TIMEZONE=Asia/Shanghai

# 相对路径约定：以仓库根目录解析
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/afterstory.db
CHARACTERS_DIR=./characters
AUDIO_DIR=./data/audio

# 文本模型：按实际供应商填写；不预设模型或代填凭证
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# 语音合成：按选定供应商填写；各角色 voice_id 后续放角色配置
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_TIMEOUT_SECONDS=60

# 语音识别：暂不接入时留空
ASR_PROVIDER=
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT_SECONDS=60

# 向量模型：采用语义检索时再填写
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=