            "iroi"
          ],
          "speaker_character_id": "",
          "observation": "薄荷搭好帐篷、点燃篝火感叹很有露营的感觉，伊洛伊道谢说这下能好好休息，薄荷说体力活交给她、现在正是发挥职业特长的时候。",
          "transcript_refs": [
            "u00001",
            "u00002",
            "u00003",
            "u00004"
          ]
        },
        {
          "canon_evidence_id": "nt-bv1kqoabievz-p17-e001b",
          "start_ms": 108800,
          "end_ms": 128000,
          "evidence_kind": "dialogue",
          "actor_character_ids": [
            "mint",
            "shinku"
          ],
          "speaker_character_id": "",
          "observation": "薄荷说好想烤棉花糖、要撒上跳跳糖以及番茄酱蛋黄酱黑椒酱芥末酱，真红在旁说千万别拿给她吃。",
          "transcript_refs": [
            "u00007",
            "u00008",
            "u00009",
            "u00010",
            "u00011"
          ]
        },
        {
          "canon_evidence_id": "nt-bv1kqoabievz-p17-e001c",
          "start_ms": 128267,
          "end_ms": 180267,
          "evidence_kind": "dialogue",
          "actor_character_ids": [
            "mint",
            "iroi"
          ],
          "speaker_character_id": "",
          "observation": "薄荷说真闻到了又香又甜的烤棉花糖味，伊洛伊嫌又凑上来的商绵烦人；商绵自称响应贵客需求、循着火光千里迢迢跟来，薄荷让她放心在营地休息。",
          "transcript_refs": [
            "u00012",
            "u00013",
            "u00014",
            "u00015",
            "u00016",
            "u00017",
            "u00018",
            "u00019"
          ]
        },
        {
          "canon_evidence_id": "nt-bv1kqoabievz-p17-e001d",
          "start_ms": 180800,
          "end_ms": 211467,
          "evidence_kind": "dialogue",
          "actor_character_ids": [
            "mint"
          ],
          "speaker_character_id": "",
          "observation": "商绵拿出珍藏的宝贝答谢众人，薄荷惊呼新装备让各项属性提升好多，并有人发现少了一件，商绵解释说只有与「职业」对应的装备。",
          "transcript_refs": [
            "u00020",
            "u00021",
            "u00022",
            "u00023"
          ]
        },
        {
          "canon_evidence_id": "nt-bv1kqoabievz-p17-e001e",
          "start_ms": 215733,
          "end_ms": 251467,
          "evidence_kind": "dialogue",
          "actor_character_ids": [
            "shinku"
          ],
          "speaker_character_id": "",
          "observation": "真红说没关系，商绵提议用一个充满爱的拥抱补偿、请她不要拒绝，真红答「你随意」并未拒绝，随后感慨这种放松的感觉好难得，并让旁边的人当作什么都没听见。",
          "transcript_refs": [
            "u00025",
            "u00026",
            "u00027",
            "u00028",
            "u00029",
            "u00030",
            "u00031"
          ]
        },
        {
          "canon_evidence_id": "nt-bv1kqoabievz-p17-e001f",
          "start_ms": 251733,
          "end_ms": 298400,
          "evidence_kind": "dialogue",
          "actor_character_ids": [
            "mint",
            "iroi"
          ],
          "speaker_character_id": "",
          "observation": "薄荷也想要商绵当枕头，商绵推销配套的毯子和被子，伊洛伊说全都要了，商绵正要报价时伊洛伊称已用「友情价」付过，双方就「友情」两清一事打趣。",
